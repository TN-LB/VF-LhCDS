+#ifndef IPPV_EXACT_VERIFICATION_H
+#define IPPV_EXACT_VERIFICATION_H
+
+#include <boost/multiprecision/cpp_int.hpp>
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+// Preserve the existing verifier's rational network and epsilon exactly. The
+// Boost flow network accepts long capacities; reject unrepresentable networks.
+class ExactVerification {
+public:
+    using Integer = boost::multiprecision::cpp_int;
+
+    ExactVerification(std::size_t clique_count, std::size_t candidate_size,
+                      std::size_t network_size, int h,
+                      const std::vector<std::size_t>& footprints)
+        : h_(h) {
+        if (!candidate_size || !network_size || h < 2)
+            throw std::invalid_argument("invalid exact verification dimensions");
+        const Integer square = Integer(network_size) * network_size;
+        const Integer denominator = Integer(candidate_size) * square;
+        scale_ = denominator;
+        for (auto size : footprints) {
+            if (!size || size > static_cast<std::size_t>(h))
+                throw std::invalid_argument("invalid verification footprint");
+            std::size_t a = size, b = (scale_ % size).convert_to<std::size_t>();
+            while (b) { const auto remainder = a % b; a = b; b = remainder; }
+            scale_ *= size / a;
+        }
+        // h * (clique_count / candidate_size - 1 / network_size^2).
+        sink_ = Integer(h) * (Integer(clique_count) * square - candidate_size)
+                * (scale_ / denominator);
+        checked(sink_);
+        checked(scale_ * (h - 1));
+    }
+
+    Integer unit() const { return scale_; }
+    Integer reverse() const { return scale_ * (h_ - 1); }
+    Integer share(std::size_t size) const {
+        if (!size || scale_ % size != 0)
+            throw std::invalid_argument("unscaled verification footprint");
+        return (scale_ / size) * h_;
+    }
+    long sink() const { return checked(sink_); }
+    static long checked(const Integer& value) {
+        if (value < 0 || value > (std::numeric_limits<long>::max)())
+            throw std::overflow_error("IPPV exact verification capacity exceeds long range");
+        return value.convert_to<long>();
+    }
+
+private:
+    int h_;
+    Integer scale_, sink_;
+};
+
+#endif
